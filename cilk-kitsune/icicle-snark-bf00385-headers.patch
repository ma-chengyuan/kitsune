+// Apply the natural vector alignment on BOTH device and host compiles. Under
+// nvcc (__CUDA_ARCH__) the original code used __align__; under clang-CUDA /
+// Kitsune (which never defines __CUDA_ARCH__ during device codegen) that guard
+// was skipped, leaving storage<8> only 8-byte aligned. That prevented LLVM's
+// load/store vectorizer from emitting 128-bit ld/st.shared.v2.u64, forcing
+// scalar 64-bit copies (~3.3x the L1 sector traffic). alignas is standard C++
+// and works in every path, so use it unconditionally.
+#ifdef ICICLE_NO_STORAGE_ALIGN
+#define ICICLE_STORAGE_ALIGN(x)
+#else
+#define ICICLE_STORAGE_ALIGN(x) alignas(LIMBS_ALIGNMENT(x))
