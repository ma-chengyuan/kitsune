+  // Kitsune (-ftapir=cuda) compiles a single non-NVCC pass but still needs the
+  // cuda_math / ptx.h device helpers to carry their inline-asm bodies into the
+  // outlined GPU kernels. Those headers use __forceinline__ directly, so define
+  // it here; it is unused by host-only builds that never include cuda_math.h.
+  #ifndef __forceinline__
+    #define __forceinline__ inline __attribute__((always_inline))
+  #endif
+  // cuda_math.h uses __align__ on local scratch arrays (ungated by __CUDA_ARCH__).
+  // Map it to the portable aligned attribute so the fast path compiles here.
+  #ifndef __align__
+    #define __align__(n) __attribute__((aligned(n)))
+  #endif
 #endif
 
